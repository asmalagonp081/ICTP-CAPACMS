# Archivo de prueba simple para análisis
/control/verbose 1
/run/initialize

# Configurar análisis
/analysis/setFileName test_output
/analysis/h1/set 0 100 0 1 MeV  # Configurar histograma de energía

# Espesores para el material
/simple/det/thickness 1.0 cm

# Energía de la fuente
/gun/energy 1.0 MeV

/run/beamOn 1000000